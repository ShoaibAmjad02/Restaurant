# ==============================================================================
# Required - Vercel Environment Variables
# ==============================================================================
SECRET_KEY=123456
DEBUG=False
DATABASE_URL=

# ==============================================================================
# Django (also read by settings)
# ==============================================================================
DJANGO_READ_DOT_ENV_FILE=True
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,.onrender.com,your-domain.com
DJANGO_ADMIN_URL=admin/
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True
DJANGO_ADMIN_FORCE_ALLAUTH=False

# ==============================================================================
# Supabase Configuration (alternative to DATABASE_URL)
# ==============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=media
SUPABASE_REALTIME_ENABLED=False

# ==============================================================================
# Supabase PostgreSQL Database (used when DATABASE_URL is not set)
# ==============================================================================
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.yourproject
SUPABASE_DB_PASSWORD=your-password
SUPABASE_DB_HOST=aws-0-xx-xxxx.pooler.supabase.com
SUPABASE_DB_PORT=5432

# ==============================================================================
# Redis
# ==============================================================================
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# Email
# ==============================================================================
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=megaone <noreply@example.com>
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_URL=https://api.mailgun.net/v3

# ==============================================================================
# Database Connection Pooling (Production)
# ==============================================================================
CONN_MAX_AGE=60
SUPABASE_DB_CONNECT_TIMEOUT=10
